rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users - hanya backend yang akses
    match /users/{userId} {
      allow read, write: if true;
    }

    // Categories - public read, admin write via backend
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Menus - public read, admin write via backend
    match /menus/{menuId} {
      allow read: if true;
      allow write: if true;
    }

    // Tables - public read, admin write via backend
    match /tables/{tableId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders - backend only (Flask handles auth)
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Payments - backend only (Flask handles auth)
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Counters - backend only (Flask handles auth)
    match /counters/{counterId} {
      allow read, write: if true;
    }
  }
}
